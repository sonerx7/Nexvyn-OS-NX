# Nexvyn native SDK: the optional compatibility layer (libnexvyn_compat.a) for CMake projects.
#
#   include(${NEXVYN_KIT}/toolchain/nexvyn-native.cmake)
#   include(${NEXVYN_KIT}/compat/cmake/nexvyn-compat.cmake)
#   add_executable(mygame main.c)
#   target_link_libraries(mygame PRIVATE SDL2 ...)          # your own libraries first
#   nexvyn_use_compat(mygame)                               # then the layer
#   nexvyn_compat_fsmap(mygame)                             # optional: case-insensitive paths, "\" and drive letters
#   nexvyn_add_nro(mygame TITLE "My Game" ...)
#
# Build the library once with: make -C ${NEXVYN_KIT}/compat   (needs devkitPro)
#
# nexvyn_use_compat(<target> [STRICT | STRICT_ERROR] [NO_FORCE_INCLUDE] [NO_WRAP])
#   - adds <kit>/compat/include (sys/mman.h, ucontext.h, sys/eventfd.h, dlfcn.h, sys/utsname.h, <signal.h> fixes ...)
#   - force-includes nexvyn/compat_posix.h (prototypes newlib lacks; NO_FORCE_INCLUDE leaves that to you)
#   - links -lnexvyn_compat and the --wrap flags of wrap_core.txt (NO_WRAP: only the calls that do not replace libc ones)
#   - STRICT: fork / exec / system / popen / posix_spawn / symlink ... warn at compile time, STRICT_ERROR: they are errors
# nexvyn_compat_fsmap(<target> [FLAGS CASEFOLD BACKSLASH DRIVES VROOT])
#   - turns the path translation on for the whole program (default: all four flags); see nxc_fs_enable() for run time control
#
# Library order: the layer is linked where target_link_libraries() puts it AND once more at the very end of the link line
# of every C / C++ executable in the calling directory, so libraries that CMake places after it (a dependency of a
# dependency: libEGL behind SDL2, ...) still find __wrap_fcntl and the other wrapped calls. Call order does not matter.

include_guard(GLOBAL)

get_filename_component(NEXVYN_COMPAT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(_nxc_read_list file out)
  file(STRINGS "${file}" _lines)
  set(_flags "")
  foreach(_l IN LISTS _lines)
    string(STRIP "${_l}" _l)
    if(_l AND NOT _l MATCHES "^#")
      list(APPEND _flags "LINKER:--wrap=${_l}")
    endif()
  endforeach()
  set(${out} "${_flags}" PARENT_SCOPE)
endfunction()

# In a window (cmake -DNEXVYN_WINDOWED=ON / nxv-native build): the .nro target is not built, nexvyn_add_nro() builds the same
# sources as a .nxvmod. These helpers then only record what that module needs (properties NXN_WIN_*): the -fPIC archive
# libnexvyn_compat_pic.a, the --wrap flags (wrap_core.txt + wrap_fsmap.txt + wrap_win.txt) and the force-include.
function(_nxc_read_raw file out)
  file(STRINGS "${file}" _lines)
  set(_flags "")
  foreach(_l IN LISTS _lines)
    string(STRIP "${_l}" _l)
    if(_l AND NOT _l MATCHES "^#")
      list(APPEND _flags "-Wl,--wrap=${_l}")
    endif()
  endforeach()
  set(${out} "${_flags}" PARENT_SCOPE)
endfunction()

function(_nxc_use_compat_windowed target)
  cmake_parse_arguments(A "STRICT;STRICT_ERROR;NO_FORCE_INCLUDE;NO_WRAP" "" "" ${ARGN})
  set(_pic "${NEXVYN_COMPAT_DIR}/lib/libnexvyn_compat_pic.a")
  if(NOT EXISTS "${_pic}")
    message(WARNING "libnexvyn_compat_pic.a not found: run  make -C ${NEXVYN_COMPAT_DIR}  (devkitPro shell)")
  endif()
  target_include_directories(${target} BEFORE PRIVATE "${NEXVYN_COMPAT_DIR}/include")
  target_compile_definitions(${target} PRIVATE NXC_COMPAT=1)
  if(A_STRICT_ERROR)
    target_compile_definitions(${target} PRIVATE NXC_STRICT=2)
  elseif(A_STRICT)
    target_compile_definitions(${target} PRIVATE NXC_STRICT=1)
  endif()
  if(NOT A_NO_FORCE_INCLUDE)
    set_property(TARGET ${target} APPEND PROPERTY NXN_WIN_COMPILE_OPTIONS "SHELL:-include nexvyn/compat_posix.h")
  endif()
  set_property(TARGET ${target} APPEND PROPERTY NXN_WIN_LINK "${_pic}")
  _nxc_read_raw("${NEXVYN_COMPAT_DIR}/wrap_win.txt" _w)
  if(NOT A_NO_WRAP)
    _nxc_read_raw("${NEXVYN_COMPAT_DIR}/wrap_core.txt" _c)
    # a window cannot chdir the process: relative paths go through the layer's own working directory, so the whole
    # file-call family is always wrapped
    _nxc_read_raw("${NEXVYN_COMPAT_DIR}/wrap_fsmap.txt" _f)
    list(APPEND _w ${_c} ${_f})
  endif()
  set_property(TARGET ${target} APPEND PROPERTY NXN_WIN_LINK_OPTIONS ${_w})
endfunction()

# For a hand-written nexvyn_add_windowed() (like the showcase): the three lists it needs.
#   nexvyn_compat_window_args(_link _link_options _compile_options)
#   nexvyn_add_windowed(app NAME app SOURCES ... LINK ${_link} LINK_OPTIONS ${_link_options})
#   target_compile_options(app_objects PRIVATE ${_compile_options})
#   target_include_directories(app_objects BEFORE PRIVATE ${NEXVYN_COMPAT_DIR}/include)
function(nexvyn_compat_window_args out_link out_link_options out_compile_options)
  set(_pic "${NEXVYN_COMPAT_DIR}/lib/libnexvyn_compat_pic.a")
  if(NOT EXISTS "${_pic}")
    message(WARNING "libnexvyn_compat_pic.a not found: run  make -C ${NEXVYN_COMPAT_DIR}  (devkitPro shell)")
  endif()
  _nxc_read_raw("${NEXVYN_COMPAT_DIR}/wrap_win.txt" _w)
  _nxc_read_raw("${NEXVYN_COMPAT_DIR}/wrap_core.txt" _c)
  _nxc_read_raw("${NEXVYN_COMPAT_DIR}/wrap_fsmap.txt" _f)
  set(${out_link} "${_pic}" PARENT_SCOPE)
  set(${out_link_options} ${_w} ${_c} ${_f} PARENT_SCOPE)
  set(${out_compile_options} "SHELL:-include nexvyn/compat_posix.h" "-DNXC_COMPAT=1" PARENT_SCOPE)
endfunction()

function(nexvyn_use_compat target)
  if(NEXVYN_WINDOWED)
    _nxc_use_compat_windowed(${target} ${ARGN})
    return()
  endif()
  cmake_parse_arguments(A "STRICT;STRICT_ERROR;NO_FORCE_INCLUDE;NO_WRAP" "" "" ${ARGN})
  if(NOT EXISTS "${NEXVYN_COMPAT_DIR}/lib/libnexvyn_compat.a")
    message(WARNING "libnexvyn_compat.a not found: run  make -C ${NEXVYN_COMPAT_DIR}  (devkitPro shell)")
  endif()
  target_include_directories(${target} BEFORE PRIVATE "${NEXVYN_COMPAT_DIR}/include")
  target_compile_definitions(${target} PRIVATE NXC_COMPAT=1)
  if(A_STRICT_ERROR)
    target_compile_definitions(${target} PRIVATE NXC_STRICT=2)
  elseif(A_STRICT)
    target_compile_definitions(${target} PRIVATE NXC_STRICT=1)
  endif()
  if(NOT A_NO_FORCE_INCLUDE)
    target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:SHELL:-include nexvyn/compat_posix.h>")
  endif()
  target_link_directories(${target} PRIVATE "${NEXVYN_COMPAT_DIR}/lib")
  target_link_libraries(${target} PRIVATE nexvyn_compat)
  # A static archive is searched once, at its place on the line: a library that CMake puts later (transitive libraries
  # always come after the target's own list) cannot use it. Repeat the archive at the end of the link command.
  set(_nxc_lib "${NEXVYN_COMPAT_DIR}/lib/libnexvyn_compat.a")
  foreach(_lang C CXX)
    set(_rule "${CMAKE_${_lang}_LINK_EXECUTABLE}")
    string(FIND "${_rule}" "libnexvyn_compat.a" _nxc_at)
    if(_rule AND _nxc_at EQUAL -1)
      set(CMAKE_${_lang}_LINK_EXECUTABLE "${_rule} \"${_nxc_lib}\" -lnx" PARENT_SCOPE)
    endif()
  endforeach()
  if(NEXVYN_ABI)
    # dlopen uses the Native SDK's shared libraries (nxn_lib); the layer references them weakly, which never pulls an
    # archive member in, so ask for it here (only when libnexvyn_native is linked)
    target_link_options(${target} PRIVATE "LINKER:--undefined=nxn_lib_open")
  endif()
  if(NOT A_NO_WRAP)
    _nxc_read_list("${NEXVYN_COMPAT_DIR}/wrap_core.txt" _wraps)
    target_link_options(${target} PRIVATE ${_wraps})
  endif()
endfunction()

function(nexvyn_compat_fsmap target)
  cmake_parse_arguments(A "" "" "FLAGS" ${ARGN})
  if(NOT A_FLAGS)
    set(A_FLAGS CASEFOLD BACKSLASH DRIVES VROOT)
  endif()
  set(_value 0)
  foreach(_f IN LISTS A_FLAGS)
    if(_f STREQUAL "CASEFOLD")
      math(EXPR _value "${_value} | 1")
    elseif(_f STREQUAL "BACKSLASH")
      math(EXPR _value "${_value} | 2")
    elseif(_f STREQUAL "DRIVES")
      math(EXPR _value "${_value} | 4")
    elseif(_f STREQUAL "VROOT")
      math(EXPR _value "${_value} | 8")
    else()
      message(FATAL_ERROR "nexvyn_compat_fsmap: unknown flag ${_f}")
    endif()
  endforeach()
  set(_src "${CMAKE_CURRENT_BINARY_DIR}/${target}_nxc_fsmap.c")
  if(NEXVYN_WINDOWED)
    # the same flags word, compiled into the module (the wrap flags are already part of nexvyn_use_compat() there)
    file(GENERATE OUTPUT "${_src}" CONTENT "/* generated by nexvyn_compat_fsmap() */
const unsigned nxc_fsmap_flags = ${_value}u;
")
    target_sources(${target} PRIVATE "${_src}")
    set_source_files_properties("${_src}" PROPERTIES LANGUAGE C GENERATED TRUE)
    return()
  endif()
  file(GENERATE OUTPUT "${_src}" CONTENT "/* generated by nexvyn_compat_fsmap() */\nconst unsigned nxc_fsmap_flags = ${_value}u;\n")
  target_sources(${target} PRIVATE "${_src}")
  set_source_files_properties("${_src}" PROPERTIES LANGUAGE C GENERATED TRUE)
  _nxc_read_list("${NEXVYN_COMPAT_DIR}/wrap_fsmap.txt" _wraps)
  # the case folding code calls the real stat: harmless twice when nexvyn_use_compat() already wrapped it, needed for NO_WRAP
  list(APPEND _wraps "LINKER:--wrap=stat")
  target_link_options(${target} PRIVATE ${_wraps})
endfunction()
