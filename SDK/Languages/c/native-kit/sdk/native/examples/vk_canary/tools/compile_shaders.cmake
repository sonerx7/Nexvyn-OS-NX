# Build-time shader compilation and C-array embedding for vk_canary.
# Delegates to compile_shaders.py when Python 3 is available, otherwise executes
# the identical glslangValidator + spirv-val + little-endian uint32_t array emission
# directly in CMake (needed inside minimal cross-build shells without Python on PATH).

if(NOT VERT OR NOT FRAG OR NOT OUT OR NOT GLSLANG OR NOT SPIRV_VAL)
  message(FATAL_ERROR "compile_shaders.cmake requires -DVERT=... -DFRAG=... -DOUT=... -DGLSLANG=... -DSPIRV_VAL=...")
endif()

if(PYTHON_EXE AND EXISTS "${PYTHON_EXE}")
  execute_process(
    COMMAND "${PYTHON_EXE}" "${CMAKE_CURRENT_LIST_DIR}/compile_shaders.py"
            --vert "${VERT}" --frag "${FRAG}" --out "${OUT}"
            --glslang "${GLSLANG}" --spirv-val "${SPIRV_VAL}"
    RESULT_VARIABLE _py_rc
  )
  if(NOT _py_rc EQUAL 0)
    message(FATAL_ERROR "compile_shaders.py failed (exit ${_py_rc})")
  endif()
  return()
endif()

get_filename_component(_out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")

function(_compile_stage src spv symbol out_var)
  execute_process(
    COMMAND "${GLSLANG}" -V --target-env vulkan1.3 "${src}" -o "${spv}"
    RESULT_VARIABLE _rc
  )
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "glslang failed for ${src} (exit ${_rc})")
  endif()
  execute_process(
    COMMAND "${SPIRV_VAL}" --target-env vulkan1.3 "${spv}"
    RESULT_VARIABLE _vrc
  )
  if(NOT _vrc EQUAL 0)
    message(FATAL_ERROR "spirv-val failed for ${spv} (exit ${_vrc})")
  endif()
  file(READ "${spv}" _hex HEX)
  string(LENGTH "${_hex}" _hex_len)
  math(EXPR _rem "${_hex_len} % 8")
  if(_hex_len LESS 40 OR NOT _rem EQUAL 0)
    message(FATAL_ERROR "Invalid SPIR-V length for ${spv}")
  endif()
  math(EXPR _words "${_hex_len} / 8")
  string(SUBSTRING "${_hex}" 0 8 _magic_le)
  if(NOT _magic_le STREQUAL "03022307")
    message(FATAL_ERROR "Invalid SPIR-V magic in ${spv}: ${_magic_le}")
  endif()
  # Swap each 4-byte little-endian word (b0 b1 b2 b3 -> 0x b3 b2 b1 b0 u,)
  string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])"
         "0x\\4\\3\\2\\1u, " _body "${_hex}")
  set(_arr "static const uint32_t ${symbol}[${_words}] = {\n    ${_body}\n};\n")
  set(${out_var} "${_arr}" PARENT_SCOPE)
endfunction()

set(_vert_spv "${_out_dir}/triangle.vert.spv")
set(_frag_spv "${_out_dir}/triangle.frag.spv")
_compile_stage("${VERT}" "${_vert_spv}" "kVkCanaryVertSpv" _vert_arr)
_compile_stage("${FRAG}" "${_frag_spv}" "kVkCanaryFragSpv" _frag_arr)

set(_tmp "${OUT}.tmp")
file(WRITE "${_tmp}"
  "/* Generated by vk_canary/tools/compile_shaders.cmake (--target-env vulkan1.3). */\n"
  "#ifndef VK_CANARY_SHADERS_H\n"
  "#define VK_CANARY_SHADERS_H\n\n"
  "#include <stdint.h>\n\n"
  "${_vert_arr}\n"
  "${_frag_arr}\n"
  "#endif /* VK_CANARY_SHADERS_H */\n"
)
file(RENAME "${_tmp}" "${OUT}")
