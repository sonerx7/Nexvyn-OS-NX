+static bool NEXVYN_GL_DestroyContext(SDL_VideoDevice *_this, SDL_GLContext context)
+{
+    NEXVYN_VideoData *vd = g_video;
+    NEXVYN_GLContext *ctx = (NEXVYN_GLContext *)context;
+    (void)_this;
+    if (!ctx) {
+        return true;
+    }
+    if (ctx->display) {
+        nxn_display_close(ctx->display);
+    }
+    if (vd && vd->gl == ctx) {
+        vd->gl = NULL;
+    }
+    SDL_free(ctx);
+    return true;
+}
