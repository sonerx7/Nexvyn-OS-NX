+/* Nexvyn OS SDL3 driver (windowed native apps): audio output through the app's nxn audio stream.
+ * Added to SDL3 (zlib license) by the Nexvyn native kit. Not part of upstream SDL. */
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_NEXVYN
+
+#include "../SDL_sysaudio.h"
+#include "SDL_nexvynaudio.h"
+
+static bool NEXVYNAUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    if (device->recording) {
+        return SDL_SetError("audio recording is not available inside a Nexvyn OS window");
+    }
+    if (SDL_AUDIO_ISFLOAT(device->spec.format) && SDL_AUDIO_BITSIZE(device->spec.format) == 32) {
+        device->spec.format = SDL_AUDIO_F32;
+    } else {
+        device->spec.format = SDL_AUDIO_S16;
+    }
+    if (device->spec.channels < 1) {
+        device->spec.channels = 2;
+    } else if (device->spec.channels > 2) {
+        device->spec.channels = 2;
+    }
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return false;
+    }
+    device->hidden->mixlen = device->buffer_size;
+    device->hidden->mixbuf = (Uint8 *)SDL_calloc(1, (size_t)device->buffer_size);
+    if (!device->hidden->mixbuf) {
+        SDL_free(device->hidden);
+        device->hidden = NULL;
+        return false;
+    }
+
+    Uint32 frame = (Uint32)(SDL_AUDIO_BITSIZE(device->spec.format) / 8 * device->spec.channels);
+    device->hidden->bytes_per_ms = (Uint32)((Uint64)device->spec.freq * frame / 1000u);
+    Uint32 target = device->hidden->bytes_per_ms * 100u;
+    if (target < (Uint32)(2 * device->hidden->mixlen)) {
+        target = (Uint32)(2 * device->hidden->mixlen);
+    }
+    device->hidden->keep = target - (Uint32)device->hidden->mixlen;
+
+    nxn_audio_params p = NXN_STRUCT_INIT(nxn_audio_params);
+    p.rate = (uint32_t)device->spec.freq;
+    p.channels = (uint32_t)device->spec.channels;
+    p.format = (device->spec.format == SDL_AUDIO_F32) ? NXN_AUDIO_F32 : NXN_AUDIO_S16;
+    p.frames = (uint32_t)device->sample_frames;
+    if (nxn_audio_open(&p, &device->hidden->stream) != NXN_OK) {
+        SDL_free(device->hidden->mixbuf);
+        SDL_free(device->hidden);
+        device->hidden = NULL;
+        return SDL_SetError("nxn_audio_open: %s", nxn_last_error());
+    }
+    nxn_audio_pause(device->hidden->stream, 0);
+    return true;
+}
+
+static bool NEXVYNAUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *h = device->hidden;
+    uint32_t q = nxn_audio_queued_bytes(h->stream);
+    while (!SDL_GetAtomicInt(&device->shutdown) && q > h->keep) {
+        Uint32 ms = 1;
+        if (h->bytes_per_ms) {
+            ms = (q - h->keep) / h->bytes_per_ms;
+            if (ms < 1) ms = 1;
+            if (ms > 20) ms = 20;
+        }
+        SDL_Delay(ms);
+        q = nxn_audio_queued_bytes(h->stream);
+    }
+    return true;
+}
+
+static bool NEXVYNAUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    nxn_audio_queue(device->hidden->stream, buffer, (uint32_t)buflen);
+    return true;
+}
+
+static Uint8 *NEXVYNAUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    if (buffer_size) {
+        *buffer_size = device->hidden->mixlen;
+    }
+    return device->hidden->mixbuf;
+}
+
+static void NEXVYNAUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (!device->hidden) {
+        return;
+    }
+    if (device->hidden->stream) {
+        nxn_audio_close(device->hidden->stream);
+    }
+    SDL_free(device->hidden->mixbuf);
+    SDL_free(device->hidden);
+    device->hidden = NULL;
+}
+
+static bool NEXVYNAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    nxn_caps caps = NXN_STRUCT_INIT(nxn_caps);
+    if (nxn_caps_get(&caps) != NXN_OK || !(caps.features & NXN_CAP_WINDOWED) || !(caps.features & NXN_CAP_AUDIO)) {
+        return false;
+    }
+    impl->OpenDevice = NEXVYNAUDIO_OpenDevice;
+    impl->WaitDevice = NEXVYNAUDIO_WaitDevice;
+    impl->PlayDevice = NEXVYNAUDIO_PlayDevice;
+    impl->GetDeviceBuf = NEXVYNAUDIO_GetDeviceBuf;
+    impl->CloseDevice = NEXVYNAUDIO_CloseDevice;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    return true;
+}
+
+AudioBootStrap NEXVYNAUDIO_bootstrap = {
+    .name = "nexvyn",
+    .desc = "Nexvyn OS audio driver",
+    .init = NEXVYNAUDIO_Init,
+    .demand_only = false,
+    .is_preferred = true,
+};
