+static bool NEXVYN_GL_SetSwapInterval(SDL_VideoDevice *_this, int interval)
+{
+    (void)_this;
+    if (interval == 1 || interval == 0 || interval == -1) {
+        return true;
+    }
+    return SDL_SetError("swap interval %d is not available (0, 1 or -1)", interval);
+}
+
+static bool NEXVYN_GL_GetSwapInterval(SDL_VideoDevice *_this, int *interval)
+{
+    (void)_this;
+    if (interval) {
+        *interval = 1;
+    }
+    return true;
+}
