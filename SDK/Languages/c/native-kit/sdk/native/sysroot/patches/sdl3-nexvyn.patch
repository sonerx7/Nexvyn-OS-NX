+static bool NEXVYN_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    (void)device_index;
+    joystick->nbuttons = NEXVYN_BUTTONS;
+    joystick->naxes = 4;
+    joystick->nhats = 0;
+    joystick->instance_id = g_instance;
+    g_buttons = 0;
+    SDL_memset(g_axes, 0, sizeof(g_axes));
+    return true;
+}
+
+static bool NEXVYN_JoystickRumble(SDL_Joystick *joystick, Uint16 low, Uint16 high)
+{
+    (void)joystick;
+    nxn_caps caps = NXN_STRUCT_INIT(nxn_caps);
+    if (nxn_caps_get(&caps) == NXN_OK && (caps.features & NXN_CAP_RUMBLE)) {
+        Uint16 mx = low > high ? low : high;
+        nxn_rumble((float)mx / 65535.0f, mx ? 2000u : 0u);
+        return true;
+    }
+    return SDL_Unsupported();
+}
+
+static bool NEXVYN_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left, Uint16 right)
