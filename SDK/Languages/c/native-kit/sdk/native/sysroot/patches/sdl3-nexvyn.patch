+
+static bool NEXVYN_VideoInit(SDL_VideoDevice *_this)
+{
+    NEXVYN_VideoData *vd = (NEXVYN_VideoData *)SDL_calloc(1, sizeof(*vd));
+    (void)_this;
+    if (!vd) {
+        return false;
+    }
+    g_video = vd;
+    nxn_caps caps = NXN_STRUCT_INIT(nxn_caps);
+    vd->usb_input = nxn_caps_get(&caps) == NXN_OK && (caps.features & NXN_CAP_USB_INPUT) != 0;
+    if (vd->usb_input) {
+        SDL_AddKeyboard(NEXVYN_KEYBOARD_ID, "Nexvyn Keyboard");
+        SDL_AddMouse(NEXVYN_MOUSE_ID, "Nexvyn Pointer");
+    }
+    SDL_DisplayMode mode;
+    SDL_zero(mode);
+    mode.w = 1280;
+    mode.h = 720;
+    mode.refresh_rate = 60.0f;
+    mode.format = SDL_PIXELFORMAT_RGBA8888;
+    if (SDL_AddBasicVideoDisplay(&mode) == 0) {
+        g_video = NULL;
+        SDL_free(vd);
+        return false;
+    }
+    return true;
+}
+
+static void NEXVYN_VideoQuit(SDL_VideoDevice *_this)
+{
+    NEXVYN_VideoData *vd = g_video;
+    if (!vd) {
+        return;
+    }
+    if (vd->gl) {
+        NEXVYN_GL_DestroyContext(_this, (SDL_GLContext)vd->gl);
+    }
+    if (vd->touch_added) {
+        SDL_DelTouch((SDL_TouchID)1);
+    }
+    g_video = NULL;
+    SDL_free(vd);
+}
+
+static void NEXVYN_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
