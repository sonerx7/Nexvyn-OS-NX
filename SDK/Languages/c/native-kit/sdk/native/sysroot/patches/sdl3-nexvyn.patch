+    device->RaiseWindow = NEXVYN_NoWindowOp;
+    device->SetWindowTitle = NEXVYN_NoWindowOp;
+    device->SetWindowSize = NEXVYN_NoWindowOp;
+    device->PumpEvents = NEXVYN_PumpEvents;
+    device->StartTextInput = NEXVYN_StartTextInput;
+    device->StopTextInput = NEXVYN_StopTextInput;
+
+    device->GL_LoadLibrary = NEXVYN_GL_LoadLibrary;
+    device->GL_GetProcAddress = NEXVYN_GL_GetProcAddress;
+    device->GL_UnloadLibrary = NEXVYN_GL_UnloadLibrary;
+    device->GL_CreateContext = NEXVYN_GL_CreateContext;
