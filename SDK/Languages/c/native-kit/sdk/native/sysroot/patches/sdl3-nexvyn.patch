+static void NEXVYN_PollTouch(NEXVYN_VideoData *vd, const nxn_input_state *in, Uint64 ts)
+{
+    SDL_Window *window = vd->window;
+    if (!window) {
+        return;
+    }
+    float tw = window->w > 0 ? (float)window->w : 1280.0f;
+    float th = window->h > 0 ? (float)window->h : 720.0f;
+    if (!vd->touch_added) {
+        SDL_AddTouch((SDL_TouchID)1, SDL_TOUCH_DEVICE_DIRECT, "Switch");
+        vd->touch_added = 1;
+    }
+    uint32_t ids[16];
+    float xs[16], ys[16];
+    int n = 0;
+    for (uint32_t i = 0; i < in->touch_count && n < 16; i++) {
+        nxn_touch t = NXN_STRUCT_INIT(nxn_touch);
+        if (nxn_input_touch(i, &t) == NXN_OK) {
+            ids[n] = t.id;
+            xs[n] = t.x / tw;
+            ys[n] = t.y / th;
+            n++;
+        }
+    }
+    for (int i = 0; i < n; i++) {
+        int was = 0;
+        for (int j = 0; j < vd->touch_count; j++) {
+            was |= (vd->touch_ids[j] == ids[i]);
+        }
+        if (was) {
+            SDL_SendTouchMotion(ts, (SDL_TouchID)1, (SDL_FingerID)(ids[i] + 1), window, xs[i], ys[i], 1.0f);
+        } else {
+            SDL_SendTouch(ts, (SDL_TouchID)1, (SDL_FingerID)(ids[i] + 1), window, SDL_EVENT_FINGER_DOWN, xs[i], ys[i], 1.0f);
+        }
+    }
+    for (int j = 0; j < vd->touch_count; j++) {
+        int still = 0;
+        for (int i = 0; i < n; i++) {
+            still |= (ids[i] == vd->touch_ids[j]);
+        }
+        if (!still) {
+            SDL_SendTouch(ts, (SDL_TouchID)1, (SDL_FingerID)(vd->touch_ids[j] + 1), window, SDL_EVENT_FINGER_UP, 0.0f, 0.0f, 0.0f);
+        }
+    }
+    for (int i = 0; i < n; i++) {
+        vd->touch_ids[i] = ids[i];
+    }
+    vd->touch_count = n;
+}
+
+static void NEXVYN_PollUSB(NEXVYN_VideoData *vd, Uint64 ts)
+{
+    SDL_Window *window = vd->window;
+    nxn_key_event k = NXN_STRUCT_INIT(nxn_key_event);
+    while (nxn_input_key_poll(&k) > 0) {
+        if (vd->focused && window && k.usage > 0 && k.usage < SDL_SCANCODE_COUNT) {
+            SDL_SendKeyboardKey(ts, NEXVYN_KEYBOARD_ID, (int)k.usage, (SDL_Scancode)k.usage, k.down != 0);
+        }
+        k.size = sizeof k;
+    }
+    char text[64];
+    while (nxn_input_text(text, sizeof(text)) > 0) {
+        if (vd->focused && window && SDL_TextInputActive(window)) {
+            SDL_SendKeyboardText(text);
+        }
+    }
+    nxn_mouse m = NXN_STRUCT_INIT(nxn_mouse);
+    if (nxn_input_mouse(&m) != NXN_OK || !vd->focused || !window) {
+        return;
+    }
+    static const struct {
+        uint32_t bit;
+        Uint8 button;
+    } buttons[3] = {
+        {NXN_MOUSE_LEFT, SDL_BUTTON_LEFT},
+        {NXN_MOUSE_MIDDLE, SDL_BUTTON_MIDDLE},
+        {NXN_MOUSE_RIGHT, SDL_BUTTON_RIGHT}
+    };
+    if (m.present) {
+        if (SDL_GetWindowRelativeMouseMode(window)) {
+            if (m.dx != 0.0f || m.dy != 0.0f) {
+                SDL_SendMouseMotion(ts, window, NEXVYN_MOUSE_ID, true, m.dx, m.dy);
+            }
+        } else if (!vd->mouse_seen || (int)m.x != vd->mouse_x || (int)m.y != vd->mouse_y) {
+            SDL_SendMouseMotion(ts, window, NEXVYN_MOUSE_ID, false, m.x, m.y);
+        }
+        vd->mouse_seen = 1;
+        vd->mouse_x = (int)m.x;
+        vd->mouse_y = (int)m.y;
+    }
+    for (int i = 0; i < 3; i++) {
+        if (m.pressed & buttons[i].bit) {
+            SDL_SendMouseButton(ts, window, NEXVYN_MOUSE_ID, buttons[i].button, true);
+        }
+        if (m.released & buttons[i].bit) {
+            SDL_SendMouseButton(ts, window, NEXVYN_MOUSE_ID, buttons[i].button, false);
+        }
+    }
+    if (m.wheel_x != 0.0f || m.wheel_y != 0.0f) {
+        SDL_SendMouseWheel(ts, window, NEXVYN_MOUSE_ID, m.wheel_x, m.wheel_y, SDL_MOUSEWHEEL_NORMAL);
+    }
+}
+
+static bool NEXVYN_StartTextInput(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID props)
+{
+    nxn_caps caps = NXN_STRUCT_INIT(nxn_caps);
+    (void)_this;
+    (void)window;
+    (void)props;
+    if (nxn_caps_get(&caps) == NXN_OK && (caps.features & NXN_CAP_TEXT_REQUEST) != 0) {
+        nxn_input_text_request(1);
+    }
+    return true;
+}
+
+static bool NEXVYN_StopTextInput(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    nxn_caps caps = NXN_STRUCT_INIT(nxn_caps);
+    (void)_this;
+    (void)window;
+    if (nxn_caps_get(&caps) == NXN_OK && (caps.features & NXN_CAP_TEXT_REQUEST) != 0) {
+        nxn_input_text_request(0);
+    }
+    return true;
+}
+
+static void NEXVYN_PumpEvents(SDL_VideoDevice *_this)
+{
+    NEXVYN_VideoData *vd = g_video;
+    (void)_this;
+    if (!vd) {
+        return;
+    }
+#ifdef SDL_VIDEO_VULKAN
+    if (vd->vk_pending_w && vd->vk_pending_h) {
+        if (vd->window) {
+            SDL_SendWindowEvent(vd->window, SDL_EVENT_WINDOW_RESIZED, vd->vk_pending_w, vd->vk_pending_h);
+        }
+        vd->vk_pending_w = vd->vk_pending_h = 0;
+    }
+#endif
+    nxn_event e = NXN_STRUCT_INIT(nxn_event);
+    while (nxn_event_poll(&e) > 0) {
+        switch (e.type) {
+        case NXN_EVENT_RESIZE:
+#ifdef SDL_VIDEO_VULKAN
+            if (vd->window && (vd->window->flags & SDL_WINDOW_VULKAN) && e.width && e.height) {
+                SDL_SendWindowEvent(vd->window, SDL_EVENT_WINDOW_RESIZED, (int)e.width, (int)e.height);
+                break;
+            }
+#endif
+            if (vd->window && vd->gl && vd->gl->follow && e.width && e.height) {
+                if (nxn_display_resize(vd->gl->display, e.width, e.height) == NXN_OK) {
+                    SDL_SendWindowEvent(vd->window, SDL_EVENT_WINDOW_RESIZED, (int)e.width, (int)e.height);
+                }
+            }
+            break;
+        case NXN_EVENT_QUIT:
+            SDL_SendQuit();
+            break;
+        case NXN_EVENT_SUSPEND:
+            SDL_SendAppEvent(SDL_EVENT_WILL_ENTER_BACKGROUND);
+            SDL_SendAppEvent(SDL_EVENT_DID_ENTER_BACKGROUND);
+            break;
+        case NXN_EVENT_RESUME:
+            SDL_SendAppEvent(SDL_EVENT_WILL_ENTER_FOREGROUND);
+            SDL_SendAppEvent(SDL_EVENT_DID_ENTER_FOREGROUND);
+            break;
+        case NXN_EVENT_FOCUS:
+            vd->focused = e.focused ? 1 : 0;
+            if (vd->window) {
+                if (e.focused) {
+                    SDL_SetKeyboardFocus(vd->window);
+                    SDL_SetMouseFocus(vd->window);
+                } else {
+                    SDL_SetKeyboardFocus(NULL);
+                    SDL_SetMouseFocus(NULL);
+                }
+            }
+            break;
+        default:
+            break;
+        }
+        e.size = sizeof e;
+    }
+    Uint64 ts = SDL_GetTicksNS();
+    const nxn_input_state *in = NEXVYN_PollInput(1);
+    if (vd->focused) {
+        NEXVYN_PollTouch(vd, in, ts);
+    }
+    if (vd->usb_input) {
+        NEXVYN_PollUSB(vd, ts);
+    }
+}
+
