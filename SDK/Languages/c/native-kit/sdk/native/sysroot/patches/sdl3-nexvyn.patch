+    device->GL_SetSwapInterval = NEXVYN_GL_SetSwapInterval;
+    device->GL_GetSwapInterval = NEXVYN_GL_GetSwapInterval;
+    device->GL_SwapWindow = NEXVYN_GL_SwapWindow;
+    device->GL_DestroyContext = NEXVYN_GL_DestroyContext;
+    device->GL_DefaultProfileConfig = NEXVYN_GL_DefaultProfileConfig;
+
+#ifdef SDL_VIDEO_VULKAN
+    device->Vulkan_LoadLibrary = NEXVYN_Vulkan_LoadLibrary;
+    device->Vulkan_UnloadLibrary = NEXVYN_Vulkan_UnloadLibrary;
+    device->Vulkan_GetInstanceExtensions = NEXVYN_Vulkan_GetInstanceExtensions;
+    device->Vulkan_CreateSurface = NEXVYN_Vulkan_CreateSurface;
+    device->Vulkan_DestroySurface = NEXVYN_Vulkan_DestroySurface;
+    device->Vulkan_GetPresentationSupport = NEXVYN_Vulkan_GetPresentationSupport;
+#endif
+    return device;
+}
