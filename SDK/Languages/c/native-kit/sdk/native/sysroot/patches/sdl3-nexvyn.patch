+++ b/src/video/nexvyn/SDL_nexvynvideo.c
@@ -0,0 +1,691 @@
+/* Nexvyn OS SDL3 driver (windowed native apps): video, host Vulkan WSI hooks, GL context, events, input.
+ * Added to SDL3 (zlib license) by the Nexvyn native kit. Not part of upstream SDL. */
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_NEXVYN
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_vulkan_internal.h"
+#include "../../events/SDL_events_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_touch_c.h"
+#include "../../events/SDL_windowevents_c.h"
+
+#include "SDL_nexvynvideo.h"
+#include <nexvyn/nxn_vk.h>
+
+static NEXVYN_VideoData *g_video = NULL;
+static const SDL_KeyboardID NEXVYN_KEYBOARD_ID = 1;
+static const SDL_MouseID NEXVYN_MOUSE_ID = 1;
+
+#ifdef SDL_VIDEO_VULKAN
+/* Host WSI hooks resolved through the weak nxn_vk_proc boundary, matching the SDL2 Nexvyn adapter. */
+typedef VkResult(VKAPI_PTR *NEXVYN_VkExtensions)(uint32_t *count, const char **names);
+typedef VkResult(VKAPI_PTR *NEXVYN_VkCreateSurface)(VkInstance instance, VkSurfaceKHR *surface);
+
+static const char *const kVulkanUnavailable = "Vulkan is not available on this system";
+static const char *g_vk_extensions[8];
+static Uint32 g_vk_extension_count = 0;
+
+static bool NEXVYN_Vulkan_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    PFN_vkGetInstanceProcAddr lookup;
+    if (path && *path) {
+        return SDL_SetError("Vulkan uses the host lookup and accepts no library path");
+    }
+    if (!nxn_vk_available()) {
+        return SDL_SetError("%s", kVulkanUnavailable);
+    }
+    lookup = (PFN_vkGetInstanceProcAddr)nxn_vk_proc("vkGetInstanceProcAddr");
+    if (!lookup) {
+        return SDL_SetError("%s", kVulkanUnavailable);
+    }
+    _this->vulkan_config.vkGetInstanceProcAddr = (void *)lookup;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties =
+        (void *)lookup(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+    return true;
+}
+
+static void NEXVYN_Vulkan_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    _this->vulkan_config.vkGetInstanceProcAddr = NULL;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties = NULL;
+    g_vk_extension_count = 0;
+}
+
+static char const * const *NEXVYN_Vulkan_GetInstanceExtensions(SDL_VideoDevice *_this, Uint32 *count)
+{
+    NEXVYN_VkExtensions get_extensions = nxn_vk_available()
+        ? (NEXVYN_VkExtensions)nxn_vk_proc("nxn_vk_wsi_instance_extensions")
+        : NULL;
+    uint32_t host_count = (uint32_t)SDL_arraysize(g_vk_extensions);
+    VkResult result;
+
+    (void)_this;
+    if (!get_extensions) {
+        SDL_SetError("%s", kVulkanUnavailable);
+        if (count) {
+            *count = 0;
+        }
+        return NULL;
+    }
+    result = get_extensions(&host_count, g_vk_extensions);
+    if (result != VK_SUCCESS) {
+        SDL_SetError("Host Vulkan extension query failed (%d)", (int)result);
+        if (count) {
+            *count = 0;
+        }
+        return NULL;
+    }
+    g_vk_extension_count = host_count;
+    if (count) {
+        *count = g_vk_extension_count;
+    }
+    return g_vk_extensions;
+}
+
+static void NEXVYN_Vulkan_SyncWindowSize(SDL_Window *window, VkInstance instance, VkSurfaceKHR surface)
+{
+    PFN_vkEnumeratePhysicalDevices enumerate =
+        (PFN_vkEnumeratePhysicalDevices)nxn_vk_proc("vkEnumeratePhysicalDevices");
+    PFN_vkGetPhysicalDeviceSurfaceCapabilitiesKHR capabilities =
+        (PFN_vkGetPhysicalDeviceSurfaceCapabilitiesKHR)nxn_vk_proc("vkGetPhysicalDeviceSurfaceCapabilitiesKHR");
+    VkPhysicalDevice physical = VK_NULL_HANDLE;
+    VkSurfaceCapabilitiesKHR caps;
+    uint32_t count = 1;
+    VkResult listed;
+
+    if (!enumerate || !capabilities) {
+        return;
+    }
+    listed = enumerate(instance, &count, &physical);
+    if ((listed != VK_SUCCESS && listed != VK_INCOMPLETE) || !count || physical == VK_NULL_HANDLE) {
+        return;
+    }
+    SDL_zero(caps);
+    if (capabilities(physical, surface, &caps) != VK_SUCCESS) {
+        return;
+    }
+    if (caps.currentExtent.width == 0xFFFFFFFFu || !caps.currentExtent.width || !caps.currentExtent.height) {
+        return;
+    }
+    if (g_video && ((int)caps.currentExtent.width != window->w || (int)caps.currentExtent.height != window->h)) {
+        g_video->vk_pending_w = (int)caps.currentExtent.width;
+        g_video->vk_pending_h = (int)caps.currentExtent.height;
+    }
+}
+
+static bool NEXVYN_Vulkan_CreateSurface(SDL_VideoDevice *_this,
+                                        SDL_Window *window,
+                                        VkInstance instance,
+                                        const struct VkAllocationCallbacks *allocator,
+                                        VkSurfaceKHR *surface)
+{
+    NEXVYN_VkCreateSurface create_surface;
+    VkResult result;
+
+    (void)_this;
+    (void)allocator;
+    *surface = VK_NULL_HANDLE;
+    if (!window || !g_video || window != g_video->window) {
+        return SDL_SetError("Vulkan surface requires the app's SDL window");
+    }
+    create_surface = nxn_vk_available()
+        ? (NEXVYN_VkCreateSurface)nxn_vk_proc("nxn_vk_wsi_create_surface")
+        : NULL;
+    if (!create_surface) {
+        return SDL_SetError("%s", kVulkanUnavailable);
+    }
+    result = create_surface(instance, surface);
+    if (result != VK_SUCCESS) {
+        *surface = VK_NULL_HANDLE;
+        if (result == VK_ERROR_NATIVE_WINDOW_IN_USE_KHR) {
+            return SDL_SetError("The app's window already has a Vulkan surface or is closing");
+        }
+        return SDL_SetError("Host Vulkan surface creation failed (%d)", (int)result);
+    }
+    NEXVYN_Vulkan_SyncWindowSize(window, instance, *surface);
+    return true;
+}
+
+static void NEXVYN_Vulkan_DestroySurface(SDL_VideoDevice *_this,
+                                         VkInstance instance,
+                                         VkSurfaceKHR surface,
+                                         const struct VkAllocationCallbacks *allocator)
+{
+    if (_this->vulkan_config.vkGetInstanceProcAddr) {
+        SDL_Vulkan_DestroySurface_Internal(_this->vulkan_config.vkGetInstanceProcAddr, instance, surface, allocator);
+    }
+}
+
+static bool NEXVYN_Vulkan_GetPresentationSupport(SDL_VideoDevice *_this,
+                                                 VkInstance instance,
+                                                 VkPhysicalDevice physicalDevice,
+                                                 Uint32 queueFamilyIndex)
+{
+    (void)_this;
+    (void)instance;
+    (void)physicalDevice;
+    return nxn_vk_available() && queueFamilyIndex == 0;
+}
+#endif /* SDL_VIDEO_VULKAN */
+
+/* ------------------------------------------------------------------ shared input sample */
+
+const nxn_input_state *NEXVYN_PollInput(int force)
+{
+    static nxn_input_state state;
+    static Uint64 stamp = 0;
+    Uint64 now = SDL_GetPerformanceCounter();
+    if (!force && stamp && (now - stamp) * 1000 < SDL_GetPerformanceFrequency() * 2) {
+        return &state;
+    }
+    nxn_input_state s = NXN_STRUCT_INIT(nxn_input_state);
+    if (nxn_input_poll(&s) == NXN_OK) {
+        s.pressed |= state.pressed & ~s.released;
+        s.released |= state.released & ~s.pressed;
+        state = s;
+    }
+    stamp = now;
+    return &state;
+}
+
+/* ------------------------------------------------------------------ window & display */
+
+static bool NEXVYN_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    NEXVYN_VideoData *vd = g_video;
+    (void)_this;
+    (void)create_props;
+    if (!vd) {
+        return SDL_SetError("nexvyn video driver is not initialized");
+    }
+    if (vd->window) {
+        return SDL_SetError("a Nexvyn OS window holds one SDL window");
+    }
+    window->internal = (SDL_WindowData *)vd;
+    vd->window = window;
+    vd->focused = 1;
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    return true;
+}
+
+static void NEXVYN_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    NEXVYN_VideoData *vd = g_video;
+    (void)_this;
+    if (vd && vd->window == window) {
+        vd->window = NULL;
+    }
+    window->internal = NULL;
+}
+
+static void NEXVYN_NoWindowOp(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    (void)_this;
+    (void)window;
+}
+
+static bool NEXVYN_GetDisplayModes(SDL_VideoDevice *_this, SDL_VideoDisplay *display)
+{
+    (void)_this;
+    SDL_AddFullscreenDisplayMode(display, &display->desktop_mode);
+    return true;
+}
+
+static bool NEXVYN_SetDisplayMode(SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    (void)_this;
+    (void)display;
+    (void)mode;
+    return true;
+}
+
+/* ------------------------------------------------------------------ GL (nxn_display) */
+
+static void NEXVYN_GL_DefaultProfileConfig(SDL_VideoDevice *_this, int *mask, int *major, int *minor)
+{
+    (void)_this;
+    *mask = SDL_GL_CONTEXT_PROFILE_ES;
+    *major = 2;
+    *minor = 0;
+}
+
+static bool NEXVYN_GL_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    (void)_this;
+    (void)path;
+    return true;
+}
+
+static void NEXVYN_GL_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    (void)_this;
+}
+
+static SDL_FunctionPointer NEXVYN_GL_GetProcAddress(SDL_VideoDevice *_this, const char *proc)
+{
+    (void)_this;
+    return (SDL_FunctionPointer)nxn_display_proc(proc);
+}
+
+static SDL_GLContext NEXVYN_GL_CreateContext(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    NEXVYN_VideoData *vd = g_video;
+    if (!vd || vd->gl) {
+        SDL_SetError("a Nexvyn OS window holds one GL context");
+        return NULL;
+    }
+    nxn_display_params p = NXN_STRUCT_INIT(nxn_display_params);
+    int mask = _this->gl_config.profile_mask;
+    int major = _this->gl_config.major_version;
+    int minor = _this->gl_config.minor_version;
+    if (mask == SDL_GL_CONTEXT_PROFILE_COMPATIBILITY) {
+        SDL_SetError("OpenGL compatibility profile is not available (core 4.3 or ES 3.2)");
+        return NULL;
+    }
+    if (mask == SDL_GL_CONTEXT_PROFILE_ES) {
+        p.api = NXN_GFX_GLES;
+        if (major >= 3) {
+            p.major = (uint32_t)major;
+            p.minor = (uint32_t)minor;
+        }
+    } else {
+        p.api = NXN_GFX_GL_CORE;
+        if (major > 3 || (major == 3 && minor >= 2)) {
+            p.major = (uint32_t)major;
+            p.minor = (uint32_t)minor;
+        }
+    }
+    p.depth_bits = (uint32_t)_this->gl_config.depth_size;
+    p.stencil_bits = (uint32_t)_this->gl_config.stencil_size;
+    if (_this->gl_config.flags & SDL_GL_CONTEXT_DEBUG_FLAG) {
+        p.flags |= NXN_DISPLAY_DEBUG;
+    }
+    int follow = (window->flags & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_RESIZABLE)) != 0;
+    if (!follow) {
+        p.width = (uint32_t)window->w;
+        p.height = (uint32_t)window->h;
+    }
+    NEXVYN_GLContext *ctx = (NEXVYN_GLContext *)SDL_calloc(1, sizeof(*ctx));
+    if (!ctx) {
+        return NULL;
+    }
+    if (nxn_display_open(&p, &ctx->display) != NXN_OK) {
+        SDL_SetError("nxn_display_open: %s", nxn_last_error());
+        SDL_free(ctx);
+        return NULL;
+    }
+    ctx->window = window;
+    ctx->follow = follow;
+    vd->gl = ctx;
+    _this->gl_config.depth_size = 24;
+    _this->gl_config.stencil_size = 8;
+    uint32_t w = 0, h = 0;
+    if (nxn_display_size(ctx->display, &w, &h) == NXN_OK && w && h && ((int)w != window->w || (int)h != window->h)) {
+        SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, (int)w, (int)h);
+    }
+    return (SDL_GLContext)ctx;
+}
+
+static bool NEXVYN_GL_MakeCurrent(SDL_VideoDevice *_this, SDL_Window *window, SDL_GLContext context)
+{
+    (void)_this;
+    (void)window;
+    if (context && context != (SDL_GLContext)(g_video ? g_video->gl : NULL)) {
+        return SDL_SetError("unknown GL context");
+    }
+    return true;
+}
