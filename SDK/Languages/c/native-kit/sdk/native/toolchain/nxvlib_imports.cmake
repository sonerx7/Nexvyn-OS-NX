# Nexvyn native SDK: writes the imports of shared libraries (.nxvlib) as an EXTERN(...) linker script for the app that
# loads them (called by nexvyn_export_symbols() in nexvyn-native.cmake; `nxv-native exports` does the same).
#   cmake -DNM=<aarch64-none-elf-nm> -DLIBS=<a.nxvlib|b.nxvlib> -DOUT=<file.ld> -P nxvlib_imports.cmake
# Only strong undefined symbols are listed: a weak import the app does not have becomes NULL in the library.
if(NOT NM OR NOT LIBS OR NOT OUT)
  message(FATAL_ERROR "usage: cmake -DNM=<nm> -DLIBS=<a|b> -DOUT=<file> -P nxvlib_imports.cmake")
endif()
string(REPLACE "|" ";" _libs "${LIBS}")
set(_names "")
foreach(_f IN LISTS _libs)
  execute_process(COMMAND "${NM}" -D --undefined-only "${_f}" OUTPUT_VARIABLE _out ERROR_VARIABLE _err
                  RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "nxvlib_imports: ${NM} failed on ${_f}: ${_err}")
  endif()
  string(REPLACE "\n" ";" _lines "${_out}")
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[ \t]*U[ \t]+([^ \t]+)$")
      list(APPEND _names "${CMAKE_MATCH_1}")
    endif()
  endforeach()
endforeach()
set(_text "/* generated by nxvlib_imports.cmake - the symbols the app's shared libraries import */\n")
if(_names)
  list(REMOVE_DUPLICATES _names)
  list(SORT _names)
  string(APPEND _text "EXTERN(\n")
  foreach(_n IN LISTS _names)
    string(APPEND _text "  ${_n}\n")
  endforeach()
  string(APPEND _text ")\n")
endif()
file(WRITE "${OUT}" "${_text}")
list(LENGTH _names _count)
message(STATUS "nxvlib_imports: ${_count} imported symbols")
