{
  "id": "com.sonerx7.nxbrowser",
  "name": "NetX-Browser Mini",
  "description": {
    "tr": "Sekmeli tarayıcı, okuma modu, indirmeler, YouTube ve açık Netflix fragmanları",
    "en": "Tabbed browser with reader mode, downloads, YouTube and public Netflix trailers"
  },
  "version": "0.12.0",
  "author": "sonerx7",
  "category": "internet",
  "main": "main.js",
  "icon": "icon.png",
  "minSdk": "1.9",
  "targetSdk": "1.13",
  "window": {
    "width": 960,
    "height": 580,
    "minWidth": 460,
    "minHeight": 365,
    "resizable": true
  },
  "singleInstance": true,
  "shareTargets": [
    "url"
  ],
  "permissions": [
    "network",
    "launch"
  ],
  "runtime": "js"
}
